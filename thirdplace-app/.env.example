NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 会員申し込み・定員割れ通知メール用（https://resend.com で無料登録し、API Keyを発行）
RESEND_API_KEY=re_xxxxxxxx
# 複数の運営メンバーに直接届けたい場合は、カンマ区切りで複数指定できる
NOTIFY_EMAIL_TO=member1@example.com,member2@example.com
# 独自ドメインをResendで検証済みの場合のみ変更（未設定ならonboarding@resend.devを使用）
NOTIFY_EMAIL_FROM=THE THIRDPLACE EBISU <onboarding@resend.dev>

# 定員割れ通知（/api/cron/check-capacity）を外部から誤って叩けないようにする任意の秘密鍵。
# Vercelの環境変数に設定すると、Vercel Cronからのリクエストにのみ自動で同じ値が付与される。
# 未設定でも動作するが、設定を推奨。
CRON_SECRET=your-random-secret

# 会員データ・出欠データをNotionにも記録する場合に設定（任意）。
#
# 1. https://www.notion.so/my-integrations でIntegrationを作成しSecretを取得
# 2. Notionに以下の2つのデータベースを作成する（「名前」列以外は、列を追加するときの
#    デフォルトの「テキスト」型のまま、種類を変更せず作成すればOK）
#
#    「会員一覧」: 名前 / 連絡先 / プラン / メッセージ / 申込日時
#    「出欠一覧」: 名前 / イベント / 開催日 / 出欠 / 更新日時 / 回答ID
#
# 3. 各データベースを1のIntegrationと共有する（データベースを開き「...」→コネクト）
# 4. 各データベースをフルページで開き、URL中の32桁の英数字（データベースID）を下に設定する
NOTION_API_KEY=ntn_xxxxxxxx
NOTION_MEMBERS_DB_ID=your-members-database-id
NOTION_RESPONSES_DB_ID=your-responses-database-id

# イベント事後アンケート（/api/survey）の回答をNotionに記録する場合に設定（任意）。
# データベースには 回答者名（任意）/ 総合満足度 / 一番良かったコンテンツ / また参加したいか /
# おすすめ度(NPS 0-10) / 参加費の印象 / 次回希望イベント / 次回希望イベント（自由記述） /
# 良かった点・改善点 / 回答日時 の列が必要（選択肢・型はapp/api/survey/route.tsを参照）。
NOTION_SURVEY_DB_ID=your-survey-database-id
