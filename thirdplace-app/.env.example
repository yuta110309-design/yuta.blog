NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 会員申し込み通知メール用（https://resend.com で無料登録し、API Keyを発行）
RESEND_API_KEY=re_xxxxxxxx
NOTIFY_EMAIL_TO=your-team@example.com
# 独自ドメインをResendで検証済みの場合のみ変更（未設定ならonboarding@resend.devを使用）
NOTIFY_EMAIL_FROM=THE THIRDPLACE EBISU <onboarding@resend.dev>

# 定員割れ通知（/api/cron/check-capacity）を外部から誤って叩けないようにする任意の秘密鍵。
# Vercelの環境変数に設定すると、Vercel Cronからのリクエストにのみ自動で同じ値が付与される。
# 未設定でも動作するが、設定を推奨。
CRON_SECRET=your-random-secret

# 会員データ・出欠データをNotionにも記録する場合に設定（任意）。
# https://www.notion.so/my-integrations でIntegrationを作成しSecretを取得、
# 対象の2つのデータベースをそのIntegrationと共有（データベースの「...」→コネクト）した上で、
# 各データベースのURLに含まれるID（32桁の英数字）を指定する。
NOTION_API_KEY=ntn_xxxxxxxx
NOTION_MEMBERS_DB_ID=your-members-database-id
NOTION_RESPONSES_DB_ID=your-responses-database-id
